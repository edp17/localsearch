diff --git a/src/indexer/tracker-files-interface.c b/src/indexer/tracker-files-interface.c
--- a/src/indexer/tracker-files-interface.c
+++ b/src/indexer/tracker-files-interface.c
@@ -12,6 +12,16 @@
 #ifdef HAVE_MEMFD_CREATE
 		files_interface->fd = memfd_create ("extract-persistent-storage",
 		                                    MFD_CLOEXEC);
+
+		if (files_interface->fd < 0) {
+			g_autofree gchar *path = NULL;
+
+			path = g_strdup_printf ("%s/tracker-persistence.XXXXXX",
+			                        g_get_tmp_dir ());
+			files_interface->fd = g_mkstemp (path);
+			if (files_interface->fd >= 0)
+				unlink (path);
+		}
 #else
 		g_autofree gchar *path = NULL;
 
